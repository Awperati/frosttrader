{
  "name": "frost-trader",
  "version": "0.1.0",
  "private": true,
  "description": "Frost Trader: paper-only trading engine, backtester and the Stock numbers view. No live orders.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "vite --config client/vite.config.ts",
    "build": "vite build --config client/vite.config.ts",
    "typecheck": "tsc -p client",
    "test": "node --test \"server/**/*.test.mjs\" \"test/**/*.test.mjs\"",
    "backtest": "node scripts/backtest.mjs",
    "fetch:indexes": "node scripts/fetch-indexes.mjs",
    "check": "npm run typecheck && npm run build && npm test"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
