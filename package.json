{
  "name": "frost-trader",
  "productName": "FrostTrader",
  "version": "0.1.0",
  "private": true,
  "description": "Frost Trader: paper-only trading engine, backtester and the Stock numbers view. No live orders.",
  "author": "Awperati",
  "type": "module",
  "main": "electron/boot.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "dev": "vite --config client/vite.config.ts",
    "build": "vite build --config client/vite.config.ts",
    "typecheck": "tsc -p client",
    "test": "node --test \"server/**/*.test.mjs\" \"test/**/*.test.mjs\"",
    "backtest": "node scripts/backtest.mjs",
    "fetch:indexes": "node scripts/fetch-indexes.mjs",
    "check": "npm run typecheck && npm run build && npm test",
    "desktop": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win --publish never"
  },
  "build": {
    "appId": "au.com.frosttechnology.frosttrader",
    "productName": "FrostTrader",
    "asar": false,
    "files": [
      "client/dist/**",
      "server/**",
      "electron/**",
      "build/icon.png",
      "package.json",
      "!**/*.test.mjs"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "FrostTrader-Setup-${version}.exe"
    },
    "npmRebuild": false
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "44.9.3",
    "electron-builder": "26.18.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.6.3",
    "vite": "8.3.5"
  }
}
